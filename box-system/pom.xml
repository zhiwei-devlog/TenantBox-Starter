    <modelVersion>4.0.0</modelVersion>

    <artifactId>box-system</artifactId>

    <dependencies>
        <!-- 依赖内部的 framework -->
        <dependency>
            <groupId>com.codeboxer</groupId>
            <artifactId>box-framework</artifactId>
            <version>1.0.0</version>
        </dependency>

